# Email (opcionalno) - bez ovoga mailovi idu u dev_emails.log
RESEND_API_KEY=
FROM_EMAIL=prakse@tvoja-domena.hr
# SMTP alternativa
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Javni URL aplikacije (za linkove za odjavu u mailovima)
BASE_URL=http://localhost:8002
# Koliko često (u minutama) dohvaćati nove oglase
FETCH_INTERVAL_MINUTES=60
# Tajni token za admin API (POST /api/admin/fetch, GET /api/admin/pending; header X-Admin-Token)
ADMIN_TOKEN=
# Na ovu adresu stižu linkovi za odobravanje/odbijanje oglasa tvrtki
ADMIN_EMAIL=
