# Copy this file to .env and fill in real values when you're ready to go live.
# Until these are set, the app runs in dev mode: emails are logged to dev_emails.log
# instead of being sent, and upgrades are granted for free instead of charging via Stripe.

# --- Email (pick ONE: Resend is the simplest) ---
# Sign up free at https://resend.com (3000 emails/month free, no credit card needed to start)
RESEND_API_KEY=
FROM_EMAIL=alerts@yourdomain.com

# --- OR: plain SMTP instead of Resend ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-gmail-app-password

# --- Payments ---
# Sign up free at https://stripe.com, grab keys from the Dashboard > Developers > API keys
STRIPE_SECRET_KEY=
BASE_URL=https://yourdomain.com

# --- Affiliate links (optional, pure bonus revenue) ---
# Only fill in once you've joined an affiliate program (e.g. Amazon Associates)
AFFILIATE_TAG_PARAM=
AFFILIATE_TAG_VALUE=
